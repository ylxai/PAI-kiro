{
  "name": "@pai/kiro-adapter",
  "version": "0.1.0",
  "description": "Platform adapter to run PAI on Kiro IDE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "install:kiro": "bun run src/cli/install.ts"
  },
  "keywords": [
    "pai",
    "kiro",
    "ai",
    "adapter",
    "personal-ai-infrastructure"
  ],
  "author": "PAI-Kiro Contributors",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.15",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ylxai/PAI-kiro.git"
  },
  "bugs": {
    "url": "https://github.com/ylxai/PAI-kiro/issues"
  },
  "homepage": "https://github.com/ylxai/PAI-kiro#readme"
}
